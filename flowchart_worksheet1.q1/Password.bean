// pseudocode to check for a new password's validity
// flowchart version-no looping
DECLARE OldPassword, Passwword : STRING
// WATCH THE <- instead of = for assignment!
OldPassword <- "opensesame"
OUTPUT "Enter new password:"
INPUT Password
IF LENGTH(Password) >= 8
  THEN
    IF Password <> OldPassword
      THEN
        OUTPUT "Password ACCEPTED"
      ELSE
        OUTPUT "Password REJECTED-same as old password"
    ENDIF
  ELSE
    OUTPUT "Password REJECTED-too short"
ENDIF
