// pseudocode to check for a new password's validity
// repetition/looping version with WHILE..DO/ENDWHILE
DECLARE OldPassword: STRING
DECLARE IsValidPassword: BOOLEAN
OldPassword <- "opensesame" // WATCH THE <- instead of = for assignment!
IsValidPassword <- false
WHILE IsValidPassword = false DO
    OUTPUT "Enter new password:"
    INPUT Password
    IF LENGTH(Password) >= 8 AND Password <> OldPassword
      THEN
        IsValidPassword <- TRUE
      ELSE
        IsValidPassword <- FALSE
        OUTPUT "Password REJECTED-enter valid password"
    ENDIF
ENDWHILE

IF IsValidPassword
  THEN
    OUTPUT "Password ACCEPTED"
ENDIF
