// Algorithm #2: bubble sort optimised
// (In this case, the array is given for easier testing)

// 1: DECLARE an ARRAY
DECLARE Names : ARRAY[1:5] OF STRING
DECLARE Swapped : BOOLEAN
DECLARE Temp : STRING
DECLARE Pass : INTEGER
DECLARE End : INTEGER

Names <- { "Lois", "Peter", "Meg", "Brian", "Chris" }
End <- 5
OUTPUT "\nDisplaying the content of each index of the String Array of names"
FOR Index <- 1 TO End
    OUTPUT "Name @ index ", Index, " = ", Names[Index]
NEXT Index

// bubble sort
Pass <- 1
REPEAT
    Swapped <- false
    FOR Index <- 1 TO End-Pass
        IF Names[Index] > Names[Index+1]
          THEN
            // SWAP adjacent element if out of order
            Swapped <- true
            Temp <- Names[Index]
            Names[Index] <- Names[Index+1]
            Names[Index+1] <- Temp
        ENDIF
    NEXT Index
    Pass <- Pass + 1
UNTIL Swapped = false

OUTPUT "\nDisplaying the content of each index of the String Array of names"
FOR Index <- 1 TO End
    OUTPUT "Name @ index ", Index, " = ", Names[Index]
NEXT Index
