// STRING (and CHAR) example
// Count the vowels and consonants in a word
// assumes the input of a valid word (alphabetical characters only)
DECLARE Word : STRING
DECLARE CurrentChar : CHAR
DECLARE Index, A, E, I, O, U, Consonants: INTEGER
A <- 0
E <- 0
I <- 0
O <- 0
U <- 0
Consonants <- 0
OUTPUT "Enter a word:"
INPUT Word
// length validation check
WHILE LENGTH(Word) < 5 DO
    OUTPUT "Enter a word longer than 5 characters please:"
    INPUT Word
ENDWHILE
Word <- LCASE(Word) // UCASE for upper case conversion
FOR Index ← 1 TO LENGTH(Word)
    CurrentChar ← SUBSTRING(Word, Index, 1)
    CASE OF CurrentChar
        'a' : A <- A + 1
        'e' : E <- E + 1
        'i' : I <- I + 1
        'o' : O <- O + 1
        'u' : U <- U + 1
        OTHERWISE Consonants <- Consonants + 1
    ENDCASE
NEXT Index
OUTPUT "Vowels: As = ", A, " Es = ", E, " Is = ", I, " Os = ", O, " Us = ", U
OUTPUT "Consonants = ", Consonants

