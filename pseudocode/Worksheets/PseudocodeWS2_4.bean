// Write pseudocode that prompts the user to enter a single whole number.
// Using a FOR loop, output the multiplication table for that number
// from 1 to 12 (e.g., displaying Number * 1, Number * 2, up to Number * 12).
DECLARE Number, Product : INTEGER
OUTPUT "Enter an integer"
INPUT Number
FOR Counter <- 1 TO 12
    Product <- Number * Counter
    OUTPUT Number, " * ", Counter, " = ", Product
NEXT Counter


// Alternatively, with a WHILE loop:
// No need to DECLARE Number and Product again
// But Counter's scope is within the FOR loop only,
// so we need to DECLARE it
DECLARE Counter : INTEGER
Counter <- 1
OUTPUT "Enter an integer"
INPUT Number
WHILE Counter <= 12 DO
    Product <- Number * Counter
    OUTPUT Number, " * ", Counter, " = ", Product
    Counter <- Counter + 1
ENDWHILE
